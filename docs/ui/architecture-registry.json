        },
        "ios": {
          "status": "verified",
          "evidence": "iPhone 15 Pro iOS 17.2 simulator: four sizes, palette switch, full narrow nowrap label, accessible link and activation; VoiceOver not exercised."
        },
        "android": {
          "status": "verified",
          "evidence": "Pixel 7 Android 15 emulator: four sizes, palette switch, full narrow nowrap label, clickable/focusable accessibility node and activation; TalkBack not exercised."
        }
      }
    },
