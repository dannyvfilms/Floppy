{
  "name": "floppy-native-proof",
  "private": true,
  "version": "0.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "export": "expo export",
    "export:django": "expo export --platform web --output-dir ../src/static/native-proof",
    "test:transport": "node --no-warnings --test \"app/**/*.test.mjs\"",
    "export:search-preview": "EXPO_PUBLIC_SEARCH_PREVIEW=1 expo export --platform web --output-dir ../.floppy/expo-search-preview"
  },
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "expo": "~58.0.23",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-hinge": "~58.0.2",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reserved-regions": "^0.2.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-zeroconf": "0.17.3",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
