# Generated by the Floppy guided installer for @@ROOT@@ (built-in database).
#
# One container: Floppy plus its own PostgreSQL and Valkey, so there is no
# separate Redis service. This file belongs to the installation, not to the
# repository. Ordinary "docker compose" commands are the maintenance interface -
# run them from @@ROOT@@. See docs/deployment-bundled.md.
name: @@PROJECT@@

services:
  floppy:
    # Deliberately no container_name: see docker-compose.install.yml.tmpl.
    image: @@IMAGE@@
    restart: unless-stopped
    # Gives the web server, background jobs and the database time to stop
    # cleanly; Docker's default 10 s would cut the database off mid-write.
    stop_grace_period: 150s
    env_file:
      - "@@ENV_FILE@@"
    volumes:
      - "@@DATA_DIR@@:/floppy/db"
      - "@@PG_DIR@@:/floppy/pgdata"
      - "@@BACKUP_DIR@@:/floppy/backups"
    ports:
      - "@@BIND@@:@@PORT@@:8000"
    networks:
      - floppy-net

networks:
  floppy-net:
    driver: bridge
