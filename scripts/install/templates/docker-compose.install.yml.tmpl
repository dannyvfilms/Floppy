# Generated by the Floppy guided installer for @@ROOT@@.
#
# This file belongs to the installation, not to the repository: the checked-in
# docker-compose.yml is a documented example and is left untouched. Ordinary
# "docker compose" commands are the maintenance interface here - run them from
# @@ROOT@@.
# A project name of its own, so these containers can never be confused with -
# or take over - another Floppy stack on this host.
name: @@PROJECT@@

services:
  floppy:
    # Deliberately no container_name: a fixed name would collide with an
    # existing Floppy stack on this host, and Compose already namespaces
    # these containers by project.
    image: @@IMAGE@@
    restart: unless-stopped
    depends_on:
      redis:
        condition: service_healthy
    env_file:
      - "@@ENV_FILE@@"
    volumes:
      - "@@DATA_DIR@@:/floppy/db"
      - "@@BACKUP_DIR@@:/floppy/backups"
    ports:
      - "@@BIND@@:@@PORT@@:8000"
    networks:
      - floppy-net

  redis:
    image: redis:8-alpine
    restart: unless-stopped
    # Same persistence and memory ceiling as the documented stack: the AOF
    # covers durability, and volatile-lru keeps the cache reclaimable while the
    # Celery queues (which carry no TTL) are not.
    command: redis-server --appendonly yes --save "" --maxmemory 256mb --maxmemory-policy volatile-lru
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 30
    volumes:
      - "@@REDIS_DIR@@:/data"
    networks:
      - floppy-net

networks:
  floppy-net:
    driver: bridge
