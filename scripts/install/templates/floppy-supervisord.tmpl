#!/usr/bin/env bash
#
# Generated by the Floppy guided installer.
#
# The single entry point the host's service manager starts. It loads the
# installation's configuration, probes the host once for the resource sizing
# decision, and then runs the supervised process group in the foreground.
#
# The container entrypoint is deliberately not reused here: its ownership
# changes and filesystem layout are container-specific.

set -euo pipefail

set -a
# shellcheck disable=SC1091
. "@@ENV_FILE@@"
set +a

export PATH="@@VENV_DIR@@/bin:$PATH"
export VIRTUAL_ENV="@@VENV_DIR@@"
cd "@@SRC_DIR@@"

mkdir -p "@@RUN_DIR@@" "@@LOG_DIR@@"

# Probe once, here, so the supervised processes cannot disagree about the tier
# if the host's free memory moves between their startups. Values already set in
# the configuration are echoed back untouched.
if resource_env=$(python -c 'from config.runtime_profile import emit_env; emit_env()' 2>/dev/null); then
    eval "$resource_env"
else
    echo "[floppy] WARNING: resource detection failed; using built-in defaults" >&2
fi
export FLOPPY_RESOURCE_TIER="${FLOPPY_RESOURCE_TIER:-standard}"
export FLOPPY_CELERY_QUEUES="${FLOPPY_CELERY_QUEUES:-celery}"
export FLOPPY_CELERY_ROLE="${FLOPPY_CELERY_ROLE:-background}"
export FLOPPY_START_INTERACTIVE_WORKER="${FLOPPY_START_INTERACTIVE_WORKER:-true}"
export FLOPPY_START_DISCOVER_WORKER="${FLOPPY_START_DISCOVER_WORKER:-true}"

exec supervisord -c "@@RUN_DIR@@/supervisord.conf"
