# Generated by the Floppy guided installer.
#
# Mirrors the container's listener: one access log at the reverse-proxy
# boundary with no query strings or referrers, since those can carry OAuth
# codes and integration tokens.
worker_processes 1;
pid "@@RUN_DIR@@/nginx.pid";
error_log "@@LOG_DIR@@/nginx-error.log" warn;

events {
    worker_connections 1024;
}

http {
    include @@MIME_TYPES@@;
    default_type application/octet-stream;

    client_body_temp_path "@@RUN_DIR@@/nginx-client-body";
    proxy_temp_path "@@RUN_DIR@@/nginx-proxy";
    fastcgi_temp_path "@@RUN_DIR@@/nginx-fastcgi";
    uwsgi_temp_path "@@RUN_DIR@@/nginx-uwsgi";
    scgi_temp_path "@@RUN_DIR@@/nginx-scgi";

    log_format floppy_safe '$remote_addr [$time_local] '
                           '"$request_method $uri $server_protocol" '
                           '$status $body_bytes_sent';
    access_log "@@LOG_DIR@@/nginx-access.log" floppy_safe;

    sendfile on;
    tcp_nodelay on;
    keepalive_timeout 65;
    client_max_body_size 50M;
    client_body_buffer_size 256k;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript;

    upstream app_server {
        server 127.0.0.1:8001;
    }

    server {
        listen @@BIND@@:@@PORT@@;
        server_name _;

        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer-when-downgrade" always;

        location / {
            proxy_pass http://app_server;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        }

        location /health/ {
            access_log off;
            proxy_pass http://app_server;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        }

        location /static/ {
            alias "@@STATIC_ROOT@@/";
            expires 30d;
            add_header Cache-Control "public";
        }
    }
}
