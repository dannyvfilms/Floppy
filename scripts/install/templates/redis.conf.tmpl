# Generated by the Floppy guided installer.
#
# A dedicated loopback Redis for this installation only. A Redis already
# running on this computer is never reconfigured or shared.
bind 127.0.0.1
protected-mode yes
port @@REDIS_PORT@@
dir "@@REDIS_DIR@@"
appendonly yes
appendfilename "floppy.aof"
save ""
maxmemory 256mb
maxmemory-policy volatile-lru
daemonize no
logfile ""
