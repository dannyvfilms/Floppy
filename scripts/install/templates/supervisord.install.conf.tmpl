; Generated by the Floppy guided installer.
;
; The same process group the container runs, adapted to installation paths and
; started by the host's own service manager through @@RUN_DIR@@/floppy-supervisord.
; That wrapper loads @@ENV_FILE@@ and probes the resource profile once, so every
; program below agrees about the sizing decision.

[supervisord]
nodaemon=true
logfile=@@LOG_DIR@@/supervisord.log
logfile_maxbytes=10MB
logfile_backups=3
pidfile=@@RUN_DIR@@/supervisord.pid
childlogdir=@@LOG_DIR@@
environment=PATH="@@VENV_DIR@@/bin:%(ENV_PATH)s",VIRTUAL_ENV="@@VENV_DIR@@"

[unix_http_server]
file=@@RUN_DIR@@/supervisor.sock
chmod=0700

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix://@@RUN_DIR@@/supervisor.sock

[program:redis]
command="@@REDIS_SERVER@@" "@@RUN_DIR@@/redis.conf"
directory=@@REDIS_DIR@@
priority=1
autorestart=true
startsecs=3
stdout_logfile=@@LOG_DIR@@/redis.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3
redirect_stderr=true

[program:nginx]
command="@@NGINX@@" -c "@@RUN_DIR@@/nginx.conf" -p "@@RUN_DIR@@" -g "daemon off;"
priority=5
autorestart=true
startsecs=3
stdout_logfile=@@LOG_DIR@@/nginx.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3
redirect_stderr=true

[program:gunicorn]
command=gunicorn --config python:config.gunicorn config.wsgi:application
directory=@@SRC_DIR@@
priority=10
autorestart=true
startsecs=5
stopasgroup=true
stdout_logfile=@@LOG_DIR@@/gunicorn.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3
redirect_stderr=true

; The default worker's queue set widens on constrained hosts, absorbing the
; discover (and on minimal hosts the interactive) queue, exactly as in the
; container. The wrapper exports the values these read.
[program:celery]
command=celery --app config worker --beat --scheduler django --queues "%(ENV_FLOPPY_CELERY_QUEUES)s" --hostname=celery@%%h --loglevel INFO --without-mingle --without-gossip
directory=@@SRC_DIR@@
environment=FLOPPY_PROCESS_ROLE="%(ENV_FLOPPY_CELERY_ROLE)s"
priority=15
autorestart=true
stopasgroup=true
stopwaitsecs=60
stdout_logfile=@@LOG_DIR@@/celery.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3
redirect_stderr=true

[program:celery-interactive]
command=celery --app config worker --queues interactive --hostname=celery-interactive@%%h --loglevel INFO --without-mingle --without-gossip
directory=@@SRC_DIR@@
environment=FLOPPY_PROCESS_ROLE="interactive"
autostart=%(ENV_FLOPPY_START_INTERACTIVE_WORKER)s
priority=15
autorestart=true
stopasgroup=true
stopwaitsecs=60
stdout_logfile=@@LOG_DIR@@/celery-interactive.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3
redirect_stderr=true

[program:celery-discover]
command=celery --app config worker --queues discover --hostname=celery-discover@%%h --loglevel INFO --without-mingle --without-gossip
directory=@@SRC_DIR@@
environment=FLOPPY_PROCESS_ROLE="background"
autostart=%(ENV_FLOPPY_START_DISCOVER_WORKER)s
priority=15
autorestart=true
stopasgroup=true
stopwaitsecs=60
stdout_logfile=@@LOG_DIR@@/celery-discover.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3
redirect_stderr=true
